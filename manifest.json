{
  "manifest_version": 3,
  "name": "FlappyBird.io Autopilot",
  "version": "1.0.0",
  "description": "Intelligent Autopilot & Trajectory Assistant for flappybird.io",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlappyBird Autopilot",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://flappybird.io/*",
        "*://*.flappybird.io/*"
      ],
      "js": ["autopilot.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["autopilot.js"],
      "matches": ["*://flappybird.io/*", "*://*.flappybird.io/*"]
    }
  ]
}
